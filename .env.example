# Skill Scanner Configuration Template
# Copy this file to .env and configure your settings

# ─────────────────────────────────────────────────────────────────────────────
# LLM Configuration (Required for LLM analyzer)
# ─────────────────────────────────────────────────────────────────────────────

# Standard setup (Anthropic, OpenAI, Google AI Studio, etc.)
SKILL_SCANNER_LLM_API_KEY=your_api_key_here
SKILL_SCANNER_LLM_MODEL=openai/qwen(your_LLM_MODEL_here)
SKILL_SCANNER_LLM_BASE_URL=http://host.docker.internal:9990/v1(your_BASE_URL_here)
SKILL_SCANNER_LLM_API_VERSION=2

# OpenAI-compatible custom endpoint
# SKILL_SCANNER_LLM_API_KEY=your_custom_provider_key
# SKILL_SCANNER_LLM_PROVIDER=openai
# SKILL_SCANNER_LLM_MODEL=Cloud-Gemini-3.1-Pro
# SKILL_SCANNER_LLM_BASE_URL=https://your.internal.llm/v1

# Azure OpenAI
# SKILL_SCANNER_LLM_API_KEY=your_azure_key
# SKILL_SCANNER_LLM_MODEL=azure/gpt-4.1
# SKILL_SCANNER_LLM_BASE_URL=https://your-resource.openai.azure.com/
# SKILL_SCANNER_LLM_API_VERSION=2025-01-01-preview

# Local LLM (for Docker deployment)
# IMPORTANT: Use host.docker.internal instead of 127.0.0.1
# Example for local vLLM/Ollama:
# SKILL_SCANNER_LLM_API_KEY=not-needed
# SKILL_SCANNER_LLM_MODEL=openai/qwen2.5-72b-instruct
# SKILL_SCANNER_LLM_BASE_URL=http://host.docker.internal:9990/v1

# ─────────────────────────────────────────────────────────────────────────────
# Meta-Analyzer Configuration (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# SKILL_SCANNER_META_LLM_API_KEY=different_key
# SKILL_SCANNER_META_LLM_MODEL=gpt-4o
# SKILL_SCANNER_META_LLM_BASE_URL=
# SKILL_SCANNER_META_LLM_API_VERSION=

# ─────────────────────────────────────────────────────────────────────────────
# Threat Intelligence APIs (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# VirusTotal
# VIRUSTOTAL_API_KEY=your_virustotal_api_key

# Cisco AI Defense
# AI_DEFENSE_API_KEY=your_aidefense_api_key
# AI_DEFENSE_API_URL=https://us.api.inspect.aidefense.security.cisco.com/api/v1

# Threatbook
# THREATBOOK_API_KEY=your_threatbook_api_key

# AlienVault OTX
# OTX_API_KEY=your_otx_api_key

# ZFTip
# ZFTIP_URL=http://your-zftip-host:50000
# ZFTIP_API_KEY=your_zftip_api_key

# Cuckoo Sandbox
# CUCKOO_URL=http://your-cuckoo-host:8090
# CUCKOO_API_KEY=your_cuckoo_token

# ─────────────────────────────────────────────────────────────────────────────
# Docker Deployment Settings
# ─────────────────────────────────────────────────────────────────────────────

# Gunicorn worker count (default: 2)
# WORKERS=2

# Log level (default: info)
# LOG_LEVEL=info
